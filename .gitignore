# Node / Frontend
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
vite.config.d.ts
vite.config.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust
src-tauri/target/
src-tauri/gen/
**/*.rs.bk
*.pdb

# Tauri bundler output (installers, if ever built outside src-tauri/target/)
src-tauri/bundle/

# Flatpak build output and generated vendored-sources files -- regenerated
# fresh on every CI run from Cargo.lock/package-lock.json, see
# .github/workflows/flatpak.yml.
flatpak/flatpak-cargo-generator.py
flatpak/generated-sources.json
flatpak/node-sources.json
.flatpak-builder/
build-dir/
repo/
*.flatpak

# Runtime data — never committed, this app's SQLite DB/WAL/config/plugin
# cache live in the OS data dir (see src-tauri/src/config.rs), not here, but
# ignore defensively in case a local dev run ever writes one into the repo.
*.db
*.db-wal
*.db-shm
*.db.bak-*
config.toml
plugin-cache/
.smoke-test-data/
smoke-test.log
*.log

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Scratch files (mockups, throwaway exploration) -- never part of the app
scratch/

# Secrets — never committed, this app's plugin credentials live in the OS
# keyring exclusively (see docs/PLUGIN_ARCHITECTURE.md), never in a file, but
# ignore defensively.
.env
.env.*
