{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capability for the main window and the quick-capture window",
  "windows": ["main", "quick-capture"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "core:window:allow-set-title",
    "opener:default",
    "dialog:default",
    "updater:default",
    "process:allow-restart"
  ]
}
